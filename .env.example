# Pulled by `vercel env pull`. Authenticates Vercel Connect and AI Gateway locally.
# On Vercel it is injected at runtime, there is nothing to set.
VERCEL_OIDC_TOKEN=

# Optional. AI Gateway key when not relying on OIDC. Jev (typesafe-ai/jev) and the writing models go through the gateway.
AI_GATEWAY_API_KEY=

# Optional. GitHub connector override. Defaults to github/tia in production and github/tia-preview everywhere else.
GITHUB_CONNECTOR=
# Optional. Discord connector override. Defaults to discord/tia.
DISCORD_CONNECTOR=

# Protects POST /ops/:id/trigger and GET /ops/decisions.
INTERNAL_API_SECRET=

# Upstash Redis, from the Vercel Marketplace integration. Without it state lives in memory.
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are read the same way.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Discord fallbacks when a repo's .github/tia.yml leaves discord.* empty.
DISCORD_DIGEST_CHANNEL_ID=
DISCORD_APPROVALS_CHANNEL_ID=
# Comma separated Discord user ids allowed to use /ask and to answer approvals.
DISCORD_MAINTAINER_IDS=

# Optional. Set to false to let apply_triage write without a maintainer approval. Defaults to true.
TIA_REQUIRE_APPROVAL=
# Optional. Public repos to follow before the app is installed on them, comma separated owner/repo.
TIA_EXTRA_REPOS=
# Optional. Comma separated GitHub accounts tia answers to. A public GitHub App can be installed by
# anyone, and this ignores every other installation. Unset, every installation is answered.
TIA_ALLOWED_OWNERS=
# Optional. Evaluation model override. Defaults to typesafe-ai/jev.
JEV_MODEL=
# Optional. Appends every decision with its raw Jev answers to this JSONL file. Local runs only.
TIA_DECISIONS_JSONL=
# Optional. Set to false to stop the daily sweep from opening setup pull requests on newly installed repositories.
# It already stays off when the installation covers more than 10 repositories.
TIA_AUTO_SETUP=

# Scripts only (labels, seed, backfill, propose-setup). Falls back to `gh auth token` when unset.
# Scripts hand it to the agent code as TIA_SCRIPT_TOKEN, which replaces Connect for every GitHub call.
# Never set TIA_SCRIPT_TOKEN on a deployment.
GITHUB_TOKEN=
