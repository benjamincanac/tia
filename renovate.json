{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":maintainLockFilesWeekly",
    ":semanticCommitTypeAll(chore)"
  ],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "25 hours",
  "schedule": [
    "on Monday"
  ],
  "postUpdateOptions": [
    "pnpmDedupe"
  ],
  "packageRules": [
    {
      "description": "engines stays on the Node major, bump would pin it to a patch.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "matchDepNames": ["node"],
      "enabled": false
    },
    {
      "description": "The action tracks a major of Node and pnpm, not a patch.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["uses-with"],
      "enabled": false
    },
    {
      "description": "eve runs everything, so it gets its own revertable pull request.",
      "matchPackageNames": ["eve"],
      "groupName": "eve"
    },
    {
      "description": "eve declares microsandbox ^0.5.0 as its peer, a newer minor breaks the local build.",
      "matchPackageNames": ["microsandbox"],
      "allowedVersions": "<0.6.0"
    }
  ]
}
